 (sample index\nbackup-restore scripts): rebuild from source; offline index + swap.","autoResize":true,"lineHeight":1.25},{"id":"SKBjuOCNRD_JfdWaX23Zv","type":"text","x":2532.0,"y":5063.0,"width":258.0,"height":35.0,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["HRWRi-XCMHMt88i3FYBRP"],"frameId":null,"index":"bAe","roundness":null,"seed":271029337,"version":2,"versionNonce":1170969802,"isDeleted":false,"boundElements":null,"updated":1793750400000,"link":null,"locked":false,"fontSize":14,"fontFamily":5,"text":"You (SLA conditions: billable tier +\nreplicas)","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"You (SLA conditions: billable tier +\nreplicas)","autoResize":true,"lineHeight":1.25},{"id":"lX_wSeH_LP52yk3tCvvLy","type":"text","x":10.0,"y":5129.5,"width":42.0,"height":17.5,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["HRWRi-XCMHMt88i3FYBRP"],"frameId":null,"index":"bAf","roundness":null,"seed":1256867391,"version":2,"versionNonce":759356446,"isDeleted":false,"boundElements":null,"updated":1793750400000,"link":null,"locked":false,"fontSize":14,"fontFamily":5,"text":"C3","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"C3","autoResize":true,"lineHeight":1.25},{"id":"zo2ngC_WlxCIa48JbkX-d","type":"text","x":72.0,"y":5129.5,"width":210.0,"height":17.5,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["HRWRi-XCMHMt88i3FYBRP"],"frameId":null,"index":"bAg","roundness":null,"seed":1409232502,"version":2,"versionNonce":1594449332,"isDeleted":false,"boundElements":null,"updated":1793750400000,"link":null,"locked":false,"fontSize":14,"fontFamily":5,"text":"Azure Storage (agent files)","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Azure Storage (agent files)","autoResize":true,"lineHeight":1.25},{"id":"QmSGTRw36wCbVgWUbXb-q","type":"text","x":302.0,"y":5129.5,"width":380.0,"height":17.5,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["HRWRi-XCMHMt88i3FYBRP"],"frameId":null,"index":"bAh","roundness":null,"seed":1278496798,"version":2,"versionNonce":1252110866,"isDeleted":false,"boundElements":null,"updated":1793750400000,"link":null,"locked":false,"fontSize":14,"fontFamily":5,"text":"ZRS: synchronous across zones, no data loss.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"ZRS: synchronous across zones, no data loss.","autoResize":true,"lineHeight":1.25},{"id":"BjC-5P2LA6L1ympMNeBn0","type":"text","x":702.0,"y":5129.5,"width":770.0,"height":52.5,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["HRWRi-XCMHMt88i3FYBRP"],"frameId":null,"index":"bAi","roundness":null,"seed":1202922149,"version":2,"versionNonce":1311493039,"isDeleted":false,"boundElements":null,"updated":1793750400000,"link":null,"locked":false,"fontSize":14,"fontFamily":5,"text":"GRS and GZRS are asynchronous: RPO 'typically under 15 min, not guaranteed' (check Last Sync Time).\nCustomer-managed failover typically under 60 min RTO; the account becomes LRS after failover.\nMicrosoft-managed failover is a last resort: do not rely on it.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"GRS and GZRS are asynchronous: RPO 'typically under 15 min, not guaranteed' (check Last Sync Time).\nCustomer-managed failover typically under 60 min RTO; the account becomes LRS after failover.\nMicrosoft-managed failover is a last resort: do not rely on it.","autoResize":true,"li