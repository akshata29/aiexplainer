okeColor":"#e67700","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["sIau461hhmuwnt6T7WTjr"],"frameId":null,"index":"b1z","roundness":null,"seed":1947967365,"version":2,"versionNonce":967199745,"isDeleted":false,"boundElements":null,"updated":1793750400000,"link":null,"locked":false,"fontSize":15,"fontFamily":5,"text":"Client SDK retry","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Client SDK retry","autoResize":true,"lineHeight":1.25},{"id":"cYZcEoC-3GMiWNLP_zChM","type":"text","x":240.0,"y":1672.0,"width":2950.0,"height":18.75,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["sIau461hhmuwnt6T7WTjr"],"frameId":null,"index":"b20","roundness":null,"seed":1175817101,"version":2,"versionNonce":107870638,"isDeleted":false,"boundElements":null,"updated":1793750400000,"link":null,"locked":false,"fontSize":15,"fontFamily":5,"text":"OpenAI SDKs retry 429 by default honouring retry-after; max_retries defaults to 2 and is configurable (the docs' examples set 5). Best practice: honour retry-after-ms, otherwise exponential backoff with random jitter, and cap the retries (the docs' examples use 5 to 10). .NET: options.Retry.MaxRetries and RetryMode.Exponential; Polly adds circuit breakers","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"OpenAI SDKs retry 429 by default honouring retry-after; max_retries defaults to 2 and is configurable (the docs' examples set 5). Best practice: honour retry-after-ms, otherwise exponential backoff with random jitter, and cap the retries (the docs' examples use 5 to 10). .NET: options.Retry.MaxRetries and RetryMode.Exponential; Polly adds circuit breakers","autoResize":true,"lineHeight":1.25},{"id":"Y9OmxahxVV920zENRN4Bu","type":"text","x":10.0,"y":1704.75,"width":210.0,"height":18.75,"angle":0,"strokeColor":"#e67700","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["sIau461hhmuwnt6T7WTjr"],"frameId":null,"index":"b21","roundness":null,"seed":912451673,"version":2,"versionNonce":1269281009,"isDeleted":false,"boundElements":null,"updated":1793750400000,"link":null,"locked":false,"fontSize":15,"fontFamily":5,"text":"Rate-limit headers","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Rate-limit headers","autoResize":true,"lineHeight":1.25},{"id":"9_-MVJmqQ4RILrpJWhtgc","type":"text","x":240.0,"y":1704.75,"width":2950.0,"height":18.75,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["sIau461hhmuwnt6T7WTjr"],"frameId":null,"index":"b22","roundness":null,"seed":764868864,"version":2,"versionNonce":1189349346,"isDeleted":false,"boundElements":null,"updated":1793750400000,"link":null,"locked":false,"fontSize":15,"fontFamily":5,"text":"x-ratelimit-limit-requests and -tokens, x-ratelimit-remaining-requests and -tokens, x-ratelimit-reset-requests and -tokens, and retry-after-ms on a 429. Watch the remaining values to throttle before you hit the limit","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"x-ratelimit-limit-requests and -tokens, x-ratelimit-remaining-requests and -tokens, x-ratelimit-reset-requests and -tokens, and retry-after-ms on a 429. Watch the remaining values to throttle before you hit the limit","autoResize":true,"lineHeight":1.25},{"id":"GsiUOVtFUczBBDHlyd1Hi","type":"text","x":10.0,"y":1737.5,"width":210.0,"height":18.75,"angle":0,"strokeColor":"#e67700","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["sIau461hhmuwnt6T7WTjr"],"frameId":null,"index":"b23","roundness":null,"seed":1691475681,"version":2,"versionNonce":516000310,"isDeleted":false,"boundElements":null,"updated":1793750400000,"link":null,"locked":false,"fontSize":15,"fontFamily":5,"text":"PTU behaviour","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"PTU behaviour","autoResize":true,"lineHeight":1.25},{"id":"rW3uWW8Mq5_nXMe_kwuA6","type":"text","x":240.0,"y":1737.5,"width":2950.0,"height":18.75,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["sIau461hhmuwnt6T7WTjr"],"frameId":null,"index":"b24","roundness":null,"seed":1868381960,"version":2,"versionNonce":1385046715,"isDeleted":false,"boundElements":null,"updated":1793750400000,"link":null,"locked":false,"fontSize":15,"fontFamily":5,"text":"A PTU deployment returns a 429 immediately at 100% utilization with retry-after-ms: 'a traffic-management signal' rather than a service error; accepted requests keep predictable latency","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"A PTU deployment returns a 429 immediately at 100% utilization with retry-after-ms: 'a traffic-management signal' rather than a service error; accepted requests keep predictable latency","autoResize":true,"lineHeight":1.25},{"id":"nVUAxv6UXeOpFURYgrrEW","type":"text","x":10.0,"y":1770.25,"width":210.0,"height":18.75,"angle":0,"strokeColor":"#e67700","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["sIau461hhmuwnt6T7WTjr"],"frameId":null,"index":"b25","roundness":null,"seed":847809625,"version":2,"versionNonce":500704788,"isDeleted":false,"boundElements":null,"updated":1793750400000,"link":null,"locked":false,"fontSize":15,"fontFamily":5,"text":"429 causes","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"429 causes","autoResize":true,"lineHeight":1.25},{"id":"OsWl--dCTkzksefBONkyz","type":"text","x":240.0,"y":1770.25,"width":2950.0,"height":18.75,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["sIau461hhmuwnt6T7WTjr"],"frameId":null,"index":"b26","roundness":null,"seed":1877103970,"version":2,"versionNonce":241590725,"isDeleted":false,"boundElements":null,"updated":1793750400000,"link":null,"locked":false,"fontSize":15,"fontFamily":5,"text":"Rate limit exceeded, system capacity throttling, or a temporary rate-limit adjustment on a shared Standard pool: listed under 'Quota and capacity' in part 1. Sustained 429s below approved quota in production: open a support request","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Rate limit exceeded, system capacity throttling, or a temporary rate-limit adjustment on a shared Standard pool: listed under 'Quota and capacity' in part 1. Sustained 429s below approved quota in production: open a support request","autoResize":true,"lineHeight":1.25},{"id":"-4HInZhCysJPMYfTpZlDe","type":"text","x":10.0,"y":1803.0,"width":210.0,"height":18.75,"angle":0,"strokeColor":"#e67700","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["sIau461hhmuwnt6T7WTjr"],"frameId":null,"index":"b27","roundness":null,"seed":1685005145,"version":2,"versionNonce":930311872,"isDeleted":false,"boundElements":null,"updated":1793750400000,"link":null,"locked":false,"fontSize":15,"fontFamily":5,"text":"Gateway guidance","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Gateway guidance","autoResize":true,"lineHeight":1.25},{"id":"S3kVevHMD6eT2hq3u2pwL","type":"text","x":240.0,"y":1803.0,"width":2950.0,"height":18.75,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["sIau461hhmuwnt6T7WTjr"],"frameId":null,"index":"b28","roundness":null,"seed":2090134279,"version":2,"versionNonce":156752440,"isDeleted":false,"boundElements":null,"updated":1793750400000,"link":null,"locked":false,"fontSize":15,"fontFamily":5,"text":"Honour Retry-After and don't keep hitting an endpoint that returns 429. Don't predict throttling: use response codes. Treat 429, 500 and 503 as circuit-break signals. Retry the current request on another backend before returning a gateway error. The gateway health check signals unhealthy when no backend is available","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Honour Retry-After and don't keep hitting an endpoint that returns 429. Don't predict throttling: use response codes. Treat 429, 500 and 503 as circuit-break signals. Retry the current request on another backend before returning a gateway error. The gateway health check signals unhealthy when no backend is available","autoResize":true,"lineHeight":1.25},{"id":"Qg_yI-L5bzKvdxzLfek3M","type":"text","x":10.0,"y":1835.75,"width":210.0,"height":18.75,"angle":0,"strokeColor":"#e67700","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["sIau461hhmuwnt6T7WTjr"],"frameId":null,"index":"b29","roundness":null,"seed":696066721,"version":2,"versionNonce":57902965,"isDeleted":false,"boundElements":null,"updated":1793750400000,"link":null,"locked":false,"fontSize":15,"fontFamily":5,"text":"Health probes","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Health probes","autoResize":true,"lineHeight":1.25},{"id":"TclgwUUpTNjUDJlT9GC_h","type":"text","x":240.0,"y":1835.75,"width":2950.0,"height":37.5,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["sIau461hhmuwnt6T7WTjr"],"frameId":null,"index":"b2A","roundness":null,"seed":1387107016,"version":2,"versionNonce":1780127961,"isDeleted":false,"boundElements":null,"updated":1793750400000,"link":null,"locked":false,"fontSize":15,"fontFamily":5,"text":"Many AI services have no dedicated health endpoint and synthetic transactions consume capacity, so prefer passive signals. API Management's per-region status endpoint (/status-0123456789abcdef) covers the gateway only: add a dedicated health API. Traffic Manager probes the regional status endpoints; Application Insights availability tests probe agent endpoints from several\nlocations; Service Health and Resource Health alerts warn early","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Many AI services have no dedicated health endpoint and synthetic transactions consume capacity, so prefer passive signals. API Management's per-region status endpoint (/status-0123456789abcdef) covers the gateway only: add a dedicated health API. Traffic Manager probes the regional status endpoints; Application Insights availability tests probe agent endpoints from several\nlocations; Service Health and Resource Health alerts warn early","autoResize":true,"lineHeight":1.25},{"id":"BUo0rJZec0emynSI71Ecu","type":"text","x":0.0,"y":1890.25,"width":309.23,"height":15.0,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b2B","roundness":null,"seed":1888508896,"version":2,"versionNonce":1699559387,"isDeleted":false,"boundElements":null,"updated":1793750400000,"link":"https://learn.microsoft.com/en-us/azure/foundry/openai/how-to/quota","locked":false,"fontSize":12,"fontFamily":5,"text":"Learn: Manage quota (rate limits, 429 types, retries)","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Learn: Manage quota (rate limits, 429 types, retries)","autoResize":true,"lineHeight":1.25},{"id":"JQm9O6MGyN7u-GgWwwIIj","type":"text","x":337.23,"y":1890.25,"width":210.56,"height":15.0,"angle":0,"strokeColor":"#1971c