 with\noverlapping prefixes. Session affinity (Chat Completions, preview) asks the router to try the same model, but it never guarantees a cache\nhit.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Router sessions: with a model router, cached tokens are used automatically when the same model serves consecutive requests with\noverlapping prefixes. Session affinity (Chat Completions, preview) asks the router to try the same model, but it never guarantees a cache\nhit.","autoResize":true,"lineHeight":1.25},{"id":"4dotE9e42WchuKyOlCG5r","type":"text","x":1284.67,"y":5517.5,"width":113.44,"height":15.0,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["753L28PV6LJ9p0nSpk2EH","7Bi0Z0kxYnzfYJj5w_JkD"],"frameId":null,"index":"bFa","roundness":null,"seed":843851210,"version":2,"versionNonce":463408729,"isDeleted":false,"boundElements":null,"updated":1793750400000,"link":"https://learn.microsoft.com/en-us/azure/foundry/openai/concepts/model-router","locked":false,"fontSize":12,"fontFamily":5,"text":"Learn: Model router","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Learn: Model router","autoResize":true,"lineHeight":1.25},{"id":"7zLarI7OywxwOpp0lUz_o","type":"text","x":1242.67,"y":4789.7,"width":319.18,"height":32.5,"angle":0,"strokeColor":"#1864ab","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["7Bi0Z0kxYnzfYJj5w_JkD"],"frameId":null,"index":"bFb","roundness":null,"seed":1236219763,"version":2,"versionNonce":981408265,"isDeleted":false,"boundElements":null,"updated":1793750400000,"link":null,"locked":false,"fontSize":26,"fontFamily":5,"text":"Prompt-cache tuning loop","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Prompt-cache tuning loop","autoResize":true,"lineHeight":1.25},{"id":"oYKUqEtX3XI