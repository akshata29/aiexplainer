s only after stable blocks,\nand compare write volume with later cache reads. mode explicit with no breakpoints = no caching and no write charges (Standard,\nGPT-5.6+).","autoResize":true,"lineHeight":1.25},{"id":"6ICNADSifxoqUCNvt7Ore","type":"text","x":1284.67,"y":5368.0,"width":127.16,"height":15.0,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["6Ve_YyIviwYBSdCnScS_T","7Bi0Z0kxYnzfYJj5w_JkD"],"frameId":null,"index":"bFU","roundness":null,"seed":116785941,"version":2,"versionNonce":1359368504,"isDeleted":false,"boundElements":null,"updated":1793750400000,"link":"https://learn.microsoft.com/en-us/azure/foundry/openai/how-to/prompt-caching","locked":false,"fontSize":12,"fontFamily":5,"text":"Learn: Prompt caching","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Learn: Prompt caching","autoResize":true,"lineHeight":1.25},{"id":"WGbCP-5dWW6XCq24VDjbx","type":"rectangle","x":1242.67,"y":5407.0,"width":1114.67,"height":125.5,"angle":0,"strokeColor":"#1971c2","backgroundColor":"#e7f5ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["753L28PV6LJ9p0nSpk2EH","7Bi0Z0kxYnzfYJj5w_JkD"],"frameId":null,"index":"bFV","roundness":{"type":3},"seed":1264006970,"version":2,"versionNonce":2023801200,"isDeleted":false,"boundElements":null,"updated":1793750400000,"link":null,"locked":false},{"id":"kj7ZS-ymCzH9XnA5F6Wkl","type":"ellipse","x":1252.67,"y":5418.0,"width":24.0,"height":24.0,"angle":0,"strokeColor":"#1971c2","backgroundColor":"#a5d8ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":["753L28PV6LJ9p0nSpk2EH","7Bi0Z0kxYnzfYJj5w_JkD"],"frameId":null,"index":"bFW","roundness":{"type":2},"seed":1125998391,"version":2,"versionNonce":2022267851,"isDeleted":false,"boundElements":null,"updated":1793750400000,"link":null,"locked":false},{"id":"