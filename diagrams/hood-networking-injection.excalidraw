:null,"locked":false,"fontSize":15,"fontFamily":5,"text":"Same connection string everywhere: the FQDN doesn't change, only the answer does. If DNS returns a public IP inside\nthe VNet, check that the privatelink zone exists and is linked to the VNet; if it times out on 443, check NSG and\nfirewall rules to the PE IP.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Same connection string everywhere: the FQDN doesn't change, only the answer does. If DNS returns a public IP inside\nthe VNet, check that the privatelink zone exists and is linked to the VNet; if it times out on 443, check NSG and\nfirewall rules to the PE IP.","autoResize":true,"lineHeight":1.25},{"id":"mKoyPDr8a87pvM7FqIOZF","type":"text","x":2382.0,"y":3153.75,"width":198.85,"height":15.0,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["Eb_R3-v201IiGZ0Nf5HL6"],"frameId":null,"index":"b7D","roundness":null,"seed":125048720,"version":2,"versionNonce":925245921,"isDeleted":false,"boundElements":null,"updated":1793750400000,"link":"https://learn.microsoft.com/en-us/azure/foundry/how-to/configure-private-link","locked":false,"fontSize":12,"fontFamily":5,"text":"Learn: Configure network isolation","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Learn: Configure network isolation","autoResize":true,"lineHeight":1.25},{"id":"Tloin7Obt1blK2iTvtlEL","type":"rectangle","x":2340.0,"y":3198.75,"width":960.0,"height":142.5,"angle":0,"strokeColor":"#e8590c","backgroundColor":"#fff4e6","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":["4o9DAkHCD8zGMSMbPbxIu"],"frameId":null,"index":"b7E","roundness":{"type":3},"seed":1731672722,"version":2,"versionNonce":1382308384,"isDeleted":false,"boundElements":null,"updated":1793750400000,"link":null,"locked":false},{"id":"iq2dqiZ1L05ZxuYlHZqIa","type":"ellipse","