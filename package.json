{
  "name": "foundry-explainers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Excalidraw explainer diagrams for Microsoft Foundry, with a static viewer site.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 5391",
    "diagrams": "python -m generator.build",
    "previews": "node tools/render.mjs --all",
    "shots": "node tools/render.mjs --shots",
    "readme": "python tools/gen_readme.py",
    "qa": "python tools/qa_check.py && python tools/check_links.py",
    "site": "python -m generator.build && node tools/render.mjs --all && vite build"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "playwright-core": "1.64.1",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
